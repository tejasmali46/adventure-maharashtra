# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Required for Phase 2+)
MONGODB_URI=mongodb://localhost:27017/adventure_maharashtra

# Security & Authentication (Required for Phase 3+)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_secure_cookie_session_secret

# Payment Gateway - Razorpay Sandbox/Test Mode (Required for Phase 6+)
# If left empty, system operates in clearly labelled development mock payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Email Provider (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@adventuremaharashtra.in
